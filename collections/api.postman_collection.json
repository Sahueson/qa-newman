    {
      "name": "TC-API13 Jugador MAD solo ve partidas de su equipo",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const emails = {\"superadmin\":\"qa.superadmin@example.com\",\"player_mad\":\"qa.player.mad@example.com\",\"player_foe\":\"qa.player.foe@example.com\",\"blocked\":\"qa.blocked@example.com\"};",
              "pm.sendRequest({ url: pm.environment.get('base_url') + '/auth/v1/token?grant_type=password', method: 'POST',",
              "  header: { apikey: pm.environment.get('anon_key'), 'Content-Type': 'application/json' },",
              "  body: { mode: 'raw', raw: JSON.stringify({ email: emails['player_mad'], password: pm.environment.get('qa_password') }) } },",
              "  (err, res) => { pm.variables.set('token', err || res.code !== 200 ? 'SIN_LOGIN' : res.json().access_token); });"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.environment.get('qa_password')) { pm.test.skip(\"TC-API13 Jugador MAD solo ve partidas de su equipo\"); return; }",
              "const j = (() => { try { return pm.response.json(); } catch (e) { return null; } })();",
              "pm.test(\"TC-API13 Jugador MAD solo ve partidas de su equipo\", () => {",
              "  pm.expect(pm.variables.get('token'), 'login previo').to.not.eql('SIN_LOGIN');",
              "  pm.expect([200]).to.include(pm.response.code);",
              "  pm.expect(j).to.not.be.empty;",
              "  j.forEach((e) => pm.expect(e.squad).to.eql(\"MAD Irregulars\"));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "apikey",
            "value": "{{anon_key}}"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base_url}}/rest/v1/events?select=id,squad"
      }
    },
